{
  "name": "talarto/venue",
  "type": "project",
  "description": "Talarto single venue website for weddings and ceremonies",
  "keywords": ["laravel", "wedding", "venue", "persian", "jalali"],
  "license": "MIT",
  "require": {
    "php": "^8.4",
    "laravel/framework": "^13.0",
    "morilog/jalali": "^3.4"
  },
  "require-dev": {
    "fakerphp/faker": "^1.24",
    "laravel/pint": "^1.24",
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {"psr-4":{"Tests\\":"tests/"}},
  "scripts": {
    "post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"],
    "post-root-package-install": ["@php -r \"file_exists('.env') || copy('.env.example', '.env');\""],
    "post-create-project-cmd": ["@php artisan key:generate --ansi"]
  },
  "config": {"optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true, "allow-plugins": {"php-http/discovery": true}},
  "minimum-stability": "stable",
  "prefer-stable": true
}
